# Server URL
# Dev:  http://localhost:4000
# Prod: https://your-railway-app.up.railway.app
VITE_SOCKET_URL=http://localhost:4000

# Google Maps JavaScript API key
# Enable: Maps JavaScript API, Directions API, Geocoding API
# Restrict to your domain + Android package in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase project config (from Firebase Console → Project Settings → Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
