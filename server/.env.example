# Server port
PORT=4000

# MongoDB connection string
# Local:  mongodb://localhost:27017/bikersync
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/bikersync
MONGODB_URI=mongodb://localhost:27017/bikersync

# Allowed CORS origin for the web client
CLIENT_URL=http://localhost:5173

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_random_secret_in_production

# Google Maps API key (server-side geocoding / maps proxy)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twilio — for SOS SMS alerts (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
