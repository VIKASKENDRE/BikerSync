# Server port
PORT=4000

# MongoDB connection string
# Local:  mongodb://localhost:27017/bikersync
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/bikersync
MONGODB_URI=mongodb://localhost:27017/bikersync

# Allowed CORS origin for the web client
CLIENT_URL=http://localhost:5173

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_random_secret_in_production

# Firebase Admin SDK service account (Console -> Project settings -> Service accounts)
# Required for verifying client ID tokens (socket + REST auth). Keep \n escapes in the key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# RTDB URL for server-side membership writes (https://<project>-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=

# Auth rollout switch. false/unset = soft mode: tokens are verified when sent,
# but legacy app versions without tokens still work. Set to true once the
# authenticated client build (v1.3+) has rolled out to production users.
AUTH_ENFORCE=false

# Google Maps API key (server-side geocoding / maps proxy)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twilio — for SOS SMS alerts (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
